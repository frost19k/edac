{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "compress": {
    "minContextLimit": 64000,
    "maxContextLimit": 128000,
    "iterationNudgeThreshold": 16,
    "nudgeFrequency": 8
  },
  "strategies": {
    "purgeErrors": {
      "turns": 3
    }
  }
}
