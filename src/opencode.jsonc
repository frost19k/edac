{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openagent",
  "subagent_depth": 2,
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow",
    "skill": {
      "*": "allow",
      "exp-*": "ask",
      "int-*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.config/opencode/context/**": "allow"
    },
  },
  "plugin": [
    "opencode-pty",
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp@latest",
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "grepapp": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/usr/bin/chromium",
        "WAYLAND_DISPLAY": "wayland-0"
      },
      "enabled": true
    }
  },
  "agent": {
    // OpenCode built-in agents (user hidden)
    "compaction": {
      "hidden": true
    },
    "title": {
      "hidden": true
    },
    "summary": {
      "hidden": true
    },
    // OpenCode built-in agents (user disabled)
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
